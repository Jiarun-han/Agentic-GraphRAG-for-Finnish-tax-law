# Copy to .env and fill in what you need. Never commit .env.

# --- LLM provider (Featherless AI - OpenAI compatible) -------------------
# Get your key at https://featherless.ai
FEATHERLESS_API_KEY=
FEATHERLESS_BASE_URL=https://api.featherless.ai/v1
FEATHERLESS_MODEL=deepseek-ai/DeepSeek-V4-Pro

# --- Corpus download ----------------------------------------------------
TAXXA_DATA_RELEASE=https://github.com/Taxxa-AI/aalto-hackaton-2026/releases/download/data-v1

# --- Optional: Neo4j ----------------------------------------------------
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password
